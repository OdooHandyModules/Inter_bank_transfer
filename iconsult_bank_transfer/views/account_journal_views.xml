<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_bank_transfer" model="ir.ui.view">
        <field name="name">account.journal.form.bank.transfer</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bank_account_id']" position="before">
                <field name="bt_statements_imported" invisible="type not in ('bank', 'cash')"/>
            </xpath>
        </field>
    </record>
</odoo>
