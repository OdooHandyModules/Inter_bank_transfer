<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="baho_bank_transfer_company_rule" model="ir.rule">
        <field name="name">Bank transfers: multi-company</field>
        <field name="model_id" ref="model_baho_bank_transfer"/>
        <!-- Transfers are kept on the main company: visible from the company and from its branches. -->
        <field name="domain_force">[('company_id', 'parent_of', company_ids)]</field>
    </record>
</odoo>
